<?xml version="1.0"?>
<schema version="0.3">
    <table name="btBattlenetConnectWowCharacters">
        <field name="bID" type="I">
            <key/>
            <unsigned/>
        </field>
        <field name="title" type="C" size="255">
        </field>
        <field name="mode" type="C" size="16">
            <default value="roster"/>
        </field>
        <field name="memberSource" type="C" size="16">
            <default value="profile"/>
        </field>
        <field name="memberID" type="I">
            <unsigned/>
            <default value="0"/>
        </field>
        <field name="version" type="C" size="32">
        </field>
        <field name="sortBy" type="C" size="32">
            <default value="item_level"/>
        </field>
        <field name="progressDays" type="I">
            <unsigned/>
            <default value="30"/>
        </field>
        <field name="minLevel" type="I">
            <unsigned/>
            <default value="0"/>
        </field>
        <field name="maxItems" type="I">
            <unsigned/>
            <default value="10"/>
        </field>
        <field name="onePerUser" type="L">
            <default value="0"/>
        </field>
        <field name="showOwner" type="L">
            <default value="0"/>
        </field>
    </table>
</schema>
