#: battlenet_connect/authentication/battlenet/controller.php:81
#: battlenet_connect/authentication/battlenet/controller.php:93
msgid "You are already logged in."
msgstr "Du bist bereits angemeldet."

#: battlenet_connect/authentication/battlenet/controller.php:98
#: battlenet_connect/authentication/battlenet/controller.php:208
msgid "Battle.net authentication failed. Please try again."
msgstr "Die Anmeldung mit Battle.net ist fehlgeschlagen. Bitte versuche es erneut."

#: battlenet_connect/authentication/battlenet/controller.php:105
#: battlenet_connect/authentication/battlenet/controller.php:117
msgid "Failed to complete authentication."
msgstr "Die Anmeldung konnte nicht abgeschlossen werden."

#: battlenet_connect/authentication/battlenet/controller.php:112
msgid "This account has not yet been validated. Please check the email associated with this account and follow the link it contains."
msgstr "Dieses Konto wurde noch nicht bestätigt. Bitte prüfe die E-Mails an die Adresse dieses Kontos und folge dem enthaltenen Link."

#: battlenet_connect/authentication/battlenet/controller.php:136
msgid "No local user account is associated with this Battle.net account. Please log in with a local account and connect your Battle.net account from your user profile."
msgstr "Mit diesem Battle.net-Konto ist kein lokales Benutzerkonto verknüpft. Bitte melde dich mit einem lokalen Konto an und verknüpfe dein Battle.net-Konto in deinem Profil."

#: battlenet_connect/authentication/battlenet/controller.php:148
msgid "Your registration session has expired. Please sign in with Battle.net again."
msgstr "Deine Registrierungssitzung ist abgelaufen. Bitte melde dich erneut mit Battle.net an."

#: battlenet_connect/authentication/battlenet/controller.php:163
msgid "Please enter a valid email address."
msgstr "Bitte gib eine gültige E-Mail-Adresse ein."

#: battlenet_connect/authentication/battlenet/controller.php:168
msgid "A user account already exists for this email, please log in and attach your Battle.net account from your account page."
msgstr "Für diese E-Mail-Adresse gibt es bereits ein Benutzerkonto. Bitte melde dich an und verknüpfe dein Battle.net-Konto auf deiner Kontoseite."

#: battlenet_connect/authentication/battlenet/controller.php:177
msgid "Unable to create new account."
msgstr "Das neue Konto konnte nicht erstellt werden."

#: battlenet_connect/authentication/battlenet/controller.php:185
#, php-format
msgid "Your account has been created. We sent an email to %s: click on the link it contains to confirm your email address, then you can log in with Battle.net."
msgstr "Dein Konto wurde erstellt. Wir haben eine E-Mail an %s geschickt: Klicke auf den enthaltenen Link, um deine E-Mail-Adresse zu bestätigen. Danach kannst du dich mit Battle.net anmelden."

#: battlenet_connect/authentication/battlenet/controller.php:191
msgid "A user must be logged in to attach a Battle.net account."
msgstr "Um ein Battle.net-Konto zu verknüpfen, musst du angemeldet sein."

#: battlenet_connect/authentication/battlenet/controller.php:214
msgid "This Battle.net account is already connected to another user account."
msgstr "Dieses Battle.net-Konto ist bereits mit einem anderen Benutzerkonto verknüpft."

